<UserControl x:Class="MilesFontExtractor.Controls.MilesMark"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The Miles mark: a rounded square with a monogram "M". Same geometry as docs/logo.svg. -->
    <Viewbox Stretch="Uniform">
        <Canvas Width="100" Height="100">
            <Rectangle Width="100" Height="100" RadiusX="26" RadiusY="26" Fill="{StaticResource AccentGradient}"/>
            <Path Data="M29,71 L29,31 L50,55 L71,31 L71,71" Stroke="White" StrokeThickness="9"
                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Canvas>
    </Viewbox>
</UserControl>
